{
  "name": "@compforge/repokit",
  "version": "0.22.0",
  "description": "Native repository inspection, Git queries and Forge reads for Node.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@compforge/harness-common": "^0.5.12",
    "@compforge/ts-stdx": "^0.1.0",
    "fs-ext": "2.1.1",
    "proper-lockfile": "4.1.2",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/fs-ext": "2.0.3",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
