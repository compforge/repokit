[
  {
    "name": "public config",
    "config": {
      "forges": {
        "github.com": {
          "token": "configured"
        }
      }
    },
    "host": "github",
    "expected": {
      "host": "github.com",
      "provider": "github",
      "token": "configured",
      "apiHost": ""
    }
  },
  {
    "name": "public environment ignored",
    "config": {
      "forges": {
        "github.com": {
          "token": "configured"
        }
      }
    },
    "env": {
      "GH_TOKEN": " env-token ",
      "GITHUB_TOKEN": "other"
    },
    "host": "GITHUB.COM",
    "expected": {
      "host": "github.com",
      "provider": "github",
      "token": "configured",
      "apiHost": ""
    }
  },
  {
    "name": "environment cannot supply missing config",
    "env": {
      "GITLAB_TOKEN": "public-token"
    },
    "host": "gitlab",
    "error": "credential"
  },
  {
    "name": "private token isolated from provider env",
    "config": {
      "forges": {
        "git.example.com": {
          "provider": "gitlab",
          "token": "private"
        }
      }
    },
    "env": {
      "GITLAB_TOKEN": "wrong-host"
    },
    "host": "git.example.com",
    "expected": {
      "host": "git.example.com",
      "provider": "gitlab",
      "token": "private",
      "apiHost": ""
    }
  },
  {
    "name": "private API host",
    "config": {
      "forges": {
        "git.example.com": {
          "provider": "gitlab",
          "token": "private",
          "apiHost": "api.example.com:8443"
        }
      }
    },
    "env": {
      "FIXTURE_FORGE_TOKEN": "bound"
    },
    "host": "git.example.com",
    "expected": {
      "host": "git.example.com",
      "provider": "gitlab",
      "token": "private",
      "apiHost": "api.example.com:8443"
    }
  },
